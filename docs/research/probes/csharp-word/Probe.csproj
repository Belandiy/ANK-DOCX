<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>$(WordPiaPath)</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireWordPia" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(WordPiaPath)')" Text="Set WordPiaPath to the Microsoft Office Word PIA installed on this development machine." />
  </Target>
</Project>
